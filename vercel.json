{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/images/icon-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/mascot(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "mytarot.vercel.app"}],
      "destination": "https://mytarot.vip/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/pages/:path*", "destination": "/pages/:path*.html" }
  ]
}